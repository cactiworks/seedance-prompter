{
  "name": "seedance-prompter",
  "version": "0.1.0",
  "private": true,
  "description": "Локальный конструктор промптов для Seedance 2.5. Не публиковать.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server/index.ts",
    "dev": "node --watch-path=src/server --watch-path=src/core src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/web/**/*.css\" --allow-empty-input",
    "test": "vitest run",
    "build": "vite build",
    "check": "npm run typecheck && npm run lint && npm run lint:css && npm run test && npm run build",
    "doctor": "node src/server/doctor.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "hono": "4.13.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
